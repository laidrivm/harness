{
	"permissions": {
		"deny": [
			"Bash(npx *)",
			"Bash(npm *)",
			"Bash(pnpm *)",
			"Bash(yarn *)",
			"Bash(gh pr comment *)",
			"Bash(gh issue comment *)",
			"Bash(gh pr review *)",
			"Edit(.npmrc)"
		],
		"ask": [
			"Bash(bun add *)",
			"Bash(bun a *)",
			"Bash(bun install *)",
			"Bash(bun i *)",
			"Bash(bun remove *)",
			"Bash(bun rm *)",
			"Bash(bun r *)",
			"Bash(bun uninstall *)",
			"Bash(bun update *)",
			"Bash(bun up *)",
			"Bash(bun patch *)",
			"Bash(bun patch-commit *)",
			"Bash(bun pm pkg *)",
			"Bash(bun pm version *)",
			"Bash(bun pm trust *)",
			"Bash(gh run rerun *)",
			"Bash(gh run * rerun *)",
			"Bash(gh run cancel *)",
			"Bash(gh run * cancel *)",
			"Bash(gh run delete *)",
			"Bash(gh run * delete *)",
			"Edit(bunfig.toml)",
			"mcp__*__send_message",
			"mcp__*__reply",
			"mcp__*__forward",
			"mcp__*__notion-create-comment"
		],
		"allow": [
			"Bash(bun test *)",
			"Bash(bun run *)",
			"Bash(bun --version)",
			"Bash(bun info *)",
			"Bash(bun audit *)",
			"Bash(bun bun/pre-pr.ts *)",
			"Bash(bun bun/settings-local.ts)",
			"Bash(bun bun/notion-ask.ts *)",
			"Bash(bun node_modules/harness/bun/notion-ask.ts *)",
			"Bash(bun bun/work.ts *)",
			"Bash(bash bun/diff-budget.sh *)",
			"Bash(openspec --version)",
			"Bash(openspec archive *)",
			"Bash(openspec instructions *)",
			"Bash(openspec list *)",
			"Bash(openspec new *)",
			"Bash(openspec status *)",
			"Bash(openspec validate *)",
			"Bash(coderabbit --version)",
			"Bash(coderabbit doctor *)",
			"Bash(coderabbit review *)",
			"Bash(actionlint *)",
			"Bash(git log *)",
			"Bash(git grep *)",
			"Bash(git ls-tree *)",
			"Bash(git ls-remote *)",
			"Bash(git rev-list *)",
			"Bash(git cherry *)",
			"Bash(git check-ignore *)",
			"Bash(git help *)",
			"Bash(git branch *)",
			"Bash(git fetch *)",
			"Bash(git switch *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git rm -- *)",
			"Bash(gh run *)",
			"Bash(grep *)",
			"Bash(mkdir *)",
			"Bash(command -v *)",
			"Skill(code-review)",
			"Skill(coderabbit-local)",
			"Skill(opsx:apply)",
			"Skill(opsx:archive)",
			"Skill(opsx:explore)",
			"Skill(opsx:propose)",
			"Skill(opsx:sync)",
			"Skill(opsx:update)",
			"Skill(playwright-cli)",
			"Skill(triage)",
			"Skill(warm)",
			"Skill(zombies)",
			"WebFetch(domain:bun.com)",
			"WebFetch(domain:docs.claude.com)",
			"WebFetch(domain:docs.coderabbit.ai)",
			"WebFetch(domain:docs.github.com)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebSearch"
		]
	},
	"attribution": {
		"pr": "",
		"sessionUrl": false
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/command-guard.ts\"; if [ -f \"$g\" ]; then bun \"$g\" || exit 2; exit 0; fi; bun -e 'const c = JSON.parse(await Bun.stdin.text()).tool_input?.command ?? \"\"; if (/^bun (install|i)( --frozen-lockfile)?$/.test(c.trim())) process.exit(0); console.error(\"The harness is not installed: run bun install first.\"); process.exit(2)' || exit 2 # harness-managed"
					}
				]
			},
			{
				"matcher": "^mcp__.+__notion-update-page$",
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/notion-guard.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi # harness-managed"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/loop-guard.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi # harness-managed"
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/loop-guard.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi # harness-managed"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/flake-watch.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi # harness-managed"
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"matcher": "^mcp__.+__notion-create-comment$",
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/question-gate.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi # harness-managed"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/turn-gate.ts\"; if [ -f \"$g\" ]; then bun \"$g\" mark; fi # harness-managed"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/turn-gate.ts\"; if [ -f \"$g\" ]; then bun \"$g\" stop; fi # harness-managed"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "if [ \"$CLAUDE_CODE_REMOTE\" = true ]; then o=$(cd \"${CLAUDE_PROJECT_DIR:-.}\" && bun install --frozen-lockfile --ignore-scripts 2>&1) || { l=$(printf \"%s\" \"$o\" | tail -n 1); echo \"The harness cloud install failed${l:+: $l}\"; }; fi; bun -e 'const fs = require(\"node:fs\"); const d = process.env.CLAUDE_PROJECT_DIR ?? \".\"; if (!fs.existsSync(d + \"/node_modules/harness\")) { console.log(\"The harness is not installed: run bun install.\"); process.exit(0); } try { const m = JSON.parse(fs.readFileSync(d + \"/package.json\", \"utf8\")); const pin = (m.dependencies?.harness ?? m.devDependencies?.harness ?? \"\").match(/#([0-9a-f]{40})$/)?.[1]; const tag = fs.readFileSync(d + \"/node_modules/harness/.bun-tag\", \"utf8\").trim().match(/-([0-9a-f]{7,40})$/)?.[1]; if (pin && tag && !pin.startsWith(tag)) console.log(\"The installed harness is \" + tag + \", the pin \" + pin.slice(0, 7) + \": run bun install.\"); } catch {}' || true # harness-managed"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/transcript-archive.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi # harness-managed",
						"timeout": 60
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/flake-watch.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi # harness-managed"
					}
				]
			},
			{
				"matcher": "Skill",
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/skill-record.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi"
					}
				]
			}
		],
		"UserPromptExpansion": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "g=\"$CLAUDE_PROJECT_DIR/node_modules/harness/bun/skill-record.ts\"; if [ -f \"$g\" ]; then bun \"$g\"; fi"
					}
				]
			}
		]
	}
}
