{
	"permissions": {
		"deny": [
			"Bash(npx *)",
			"Bash(npm *)",
			"Bash(pnpm *)",
			"Bash(yarn *)",
			"Bash(gh pr comment *)",
			"Bash(gh issue comment *)",
			"Bash(gh pr review *)",
			"Edit(.npmrc)"
		],
		"ask": [
			"Bash(bun add *)",
			"Bash(bun a *)",
			"Bash(bun install *)",
			"Bash(bun i *)",
			"Bash(bun remove *)",
			"Bash(bun rm *)",
			"Bash(bun r *)",
			"Bash(bun uninstall *)",
			"Bash(bun update *)",
			"Bash(bun up *)",
			"Bash(bun patch *)",
			"Bash(bun patch-commit *)",
			"Bash(bun pm pkg *)",
			"Bash(bun pm version *)",
			"Bash(bun pm trust *)",
			"Edit(bunfig.toml)",
			"mcp__*__send_message",
			"mcp__*__reply",
			"mcp__*__forward",
			"mcp__*__notion-create-comment"
		],
		"allow": [
			"Bash(bun test *)",
			"Bash(bun run *)",
			"Bash(bun --version)",
			"Bash(bun info *)",
			"Bash(bun audit *)",
			"Bash(bun bun/pre-pr.ts *)",
			"Bash(bun bun/settings-local.ts)",
			"Bash(bash bun/diff-budget.sh *)",
			"Bash(openspec --version)",
			"Bash(openspec archive *)",
			"Bash(openspec instructions *)",
			"Bash(openspec list *)",
			"Bash(openspec new *)",
			"Bash(openspec status *)",
			"Bash(openspec validate *)",
			"Bash(coderabbit --version)",
			"Bash(coderabbit doctor *)",
			"Bash(coderabbit review *)",
			"Bash(actionlint *)",
			"Bash(git log *)",
			"Bash(git grep *)",
			"Bash(git ls-tree *)",
			"Bash(git ls-remote *)",
			"Bash(git rev-list *)",
			"Bash(git cherry *)",
			"Bash(git check-ignore *)",
			"Bash(git help *)",
			"Bash(git branch *)",
			"Bash(git fetch *)",
			"Bash(git switch *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git rm -- *)",
			"Bash(gh run *)",
			"Bash(grep *)",
			"Bash(mkdir *)",
			"Bash(command -v *)",
			"Skill(coderabbit-local)",
			"Skill(opsx:apply)",
			"Skill(opsx:archive)",
			"Skill(opsx:explore)",
			"Skill(opsx:propose)",
			"Skill(opsx:sync)",
			"Skill(opsx:update)",
			"Skill(playwright-cli)",
			"Skill(triage)",
			"Skill(warm)",
			"Skill(zombies)",
			"WebFetch(domain:bun.com)",
			"WebFetch(domain:docs.claude.com)",
			"WebFetch(domain:docs.coderabbit.ai)",
			"WebFetch(domain:docs.github.com)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebSearch"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/bun/command-guard.ts\" || exit 2"
					}
				]
			},
			{
				"matcher": "^mcp__.+__notion-update-page$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/bun/notion-guard.ts\""
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/bun/loop-guard.ts\""
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/bun/loop-guard.ts\""
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"matcher": "^mcp__.+__notion-create-comment$",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/bun/question-gate.ts\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/bun/turn-gate.ts\" mark"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/bun/turn-gate.ts\" stop"
					}
				]
			}
		]
	}
}
