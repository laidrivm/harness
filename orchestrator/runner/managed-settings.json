{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|clear",
				"hooks": [{ "type": "command", "command": "touch \"$HOME/.harness-fresh\"" }]
			},
			{
				"matcher": "startup|clear|resume",
				"hooks": [{ "type": "command", "command": "/opt/orchestrator/deploy-failed.sh" }]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{ "type": "command", "command": "rm -f \"$HOME/.harness-fresh\"" },
					{ "type": "command", "command": "/opt/orchestrator/deploy-failed.sh" }
				]
			}
		]
	}
}
