#!/usr/bin/env bash
# Enabled once per clone with `git config core.hooksPath .githooks` — the
# package has no lifecycle scripts, so no install can register it. The diff
# budget is soft here and hard in CI, as `change-slicing` requires.
set -euo pipefail
# Git hands a hook run from a worktree an absolute GIT_DIR; a fixture would
# then write into the shared .git. If this read fails, the suite's preload
# (bunfig.toml) sees the variables and refuses.
unset $(git rev-parse --local-env-vars)
# A push into an open pull request that is not a draft is refused before the
# suite runs. After the unset, so no `gh` it starts inherits git's variables.
bun bun/push-draft.ts "$@"
bun test
bash bun/diff-budget.sh || true
