{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"mutate": [
		"bun/autonomy.ts",
		"bun/bootstrap.ts",
		"bun/bump-pin.ts",
		"bun/ci-run-draft.ts",
		"bun/config.ts",
		"bun/file-size.ts",
		"bun/floor.ts",
		"bun/github-app.ts",
		"bun/manifest-ranges.ts",
		"bun/notion-release.ts",
		"bun/pr-sessions.ts",
		"bun/push-refs.ts",
		"bun/repo-layout.ts",
		"bun/review-config.ts",
		"bun/skill-record.ts",
		"bun/sync-settings.ts",
		"bun/tracked.ts",
		"bun/transcript-archive-store.ts",
		"bun/transient.ts"
	],
	"testRunner": "command",
	"buildCommand": "bun bun/mutation-sandbox.ts",
	"thresholds": {
		"break": null
	},
	"reporters": ["clear-text", "progress", "json"],
	"incremental": true,
	"tempDirName": ".stryker-tmp",
	"tsconfigFile": "tsconfig.stryker-none.json",
	"ignorePatterns": [
		"/.claude/worktrees",
		"/.claude/skills",
		"/orchestrator/secrets",
		"/orchestrator/app-key",
		"mutation"
	]
}
